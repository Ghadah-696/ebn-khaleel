<button type="button" class="back-to-top" data-back-to-top aria-label="العودة إلى الأعلى">
	<svg viewBox="0 0 24 24" aria-hidden="true">
		<path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
	</svg>
</button>

<script>
	const button = document.querySelector("[data-back-to-top]");

	if (button instanceof HTMLButtonElement) {
		const update = () => {
			button.classList.toggle("is-visible", window.scrollY > 600);
		};

		window.addEventListener("scroll", update, { passive: true });
		update();

		button.addEventListener("click", () => {
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
		});
	}
</script>

<style>
	.back-to-top {
		position: fixed;
		right: 1.25rem;
		bottom: max(1.25rem, env(safe-area-inset-bottom));
		z-index: 40;
		display: grid;
		width: 3.25rem;
		height: 3.25rem;
		place-items: center;
		border: 1px solid var(--color-gold);
		border-radius: 999px;
		background: var(--color-espresso);
		color: var(--color-cream);
		cursor: pointer;
		box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.55);
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.75rem);
		transition: opacity 220ms ease, transform 220ms ease, visibility 0s linear 220ms, background-color 180ms ease;
	}

	.back-to-top.is-visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		transition-delay: 0s;
	}

	.back-to-top:hover {
		background: var(--color-coffee);
	}

	.back-to-top svg {
		width: 1.35rem;
		height: 1.35rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.back-to-top {
			transition: none;
		}
	}
</style>