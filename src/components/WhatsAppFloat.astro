---
import { whatsappUrl } from "../data/profile";
---

<a
	class="whatsapp-float"
	href={whatsappUrl}
	target="_blank"
	rel="noopener noreferrer"
	aria-label="تواصل معي عبر واتساب"
	title="تواصل معي عبر واتساب"
>
	<svg viewBox="0 0 24 24" aria-hidden="true">
		<path fill="currentColor" d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.6 4.1 1.6 5.9L.2 24l6.5-1.7c1.7.9 3.5 1.3 5.4 1.3h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.3-6.1-3.5-8.3Zm-8.3 18.1h-.1c-1.7 0-3.4-.5-4.8-1.3l-.3-.2-3.9 1 1-3.8-.2-.3a9.7 9.7 0 0 1-1.5-5.2C2.4 6.4 6.7 2 12.1 2c2.6 0 5 1 6.9 2.9a9.7 9.7 0 0 1 2.8 6.9c0 5.4-4.3 9.8-9.6 9.8Zm5.4-7.3c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2c-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-1.6-.8-2.7-1.4-3.8-3.2-.3-.5.3-.5.9-1.7.1-.2.1-.4 0-.6l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.1 1.4 3.3c.2.2 2.3 3.5 5.5 4.8 2 .8 2.8.9 3.8.8.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4 0-.2-.3-.3-.6-.5Z" />
	</svg>
</a>

<style>
	.whatsapp-float {
		position: fixed;
		inset-block-end: 1.25rem;
		inset-inline-end: 1.25rem;
		z-index: 20;
		display: grid;
		width: 3.25rem;
		height: 3.25rem;
		place-items: center;
		border: 1px solid var(--color-coffee);
		border-radius: 999px;
		background: var(--color-coffee);
		color: var(--color-cream);
		box-shadow: 0 0.5rem 1.25rem color-mix(in srgb, var(--color-espresso) 18%, transparent);
		transition: background-color 180ms ease, transform 180ms ease;
	}

	.whatsapp-float svg {
		width: 1.45rem;
		height: 1.45rem;
	}

	.whatsapp-float:hover {
		background: var(--color-espresso);
		transform: translateY(-2px);
	}

	.whatsapp-float:active {
		transform: translateY(0);
	}

	@media (max-width: 63.999rem) {
		.whatsapp-float {
			inset-block-end: 1rem;
			inset-inline-end: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.whatsapp-float {
			transition: none;
		}
	}
</style>
