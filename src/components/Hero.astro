---
import { Image } from "astro:assets";
import profileImage from "../assets/profile.jpeg";
import { profile, whatsappUrl } from "../data/profile";
---

<!-- <section class="hero" id="home" aria-labelledby="hero-title"> -->
 <section class="hero-band" id="home" aria-labelledby="hero-title">
<div class="hero">
	<div class="hero__visual" aria-label={profile.name}>
		<div class="visual-frame visual-frame--outer" aria-hidden="true"></div>
		<div class="visual-frame visual-frame--inner" aria-hidden="true"></div>
		<div class="visual-caption" aria-hidden="true">COPY / WRITE</div>
		<div class="visual-index" aria-hidden="true">01</div>
		<Image
			src={profileImage}
			alt={profile.name}
			width={720}
			height={820}
			loading="eager"
			class="hero-image"
		/>
	</div>

	<div class="hero__copy">
		<p class="hero-name">{profile.name}</p>
		<p class="hero-eyebrow">{profile.role}</p>
		<h1 id="hero-title" class="hero-title">
	<span class="hero-title__line">أنا مو <em>بيّاع كلام..</em></span>
	<span class="hero-title__line">
		أنا كلامي{" "}
		<strong>
			بيّاع
			<svg class="hero-underline" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
				<path d="M2 8 C 25 2, 50 12, 98 4" pathLength="1" />
			</svg>
		</strong>
	</span>
</h1>
		<p class="hero-intro" data-intro>
			<span>{profile.introParagraphs.slice(0, 2).join(" ")}</span>{" "}
			<span id="hero-intro-more" class="hero-intro__remaining" hidden>
				{profile.introParagraphs.slice(2).join(" ")}
			</span>
			<button
				type="button"
				class="intro-toggle"
				data-intro-more
				aria-controls="hero-intro-more"
				aria-expanded="false"
			>
				اقرأ المزيد
			</button>
			<button
				type="button"
				class="intro-toggle"
				data-intro-less
				aria-controls="hero-intro-more"
				aria-expanded="true"
				hidden
			>
				اقرأ أقل
			</button>
		</p>

		<div class="hero__actions" id="contact">
			<p class="hero-cta-line">{profile.ctaLine}</p>
			<a
				class="hero-cta"
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path fill="currentColor" d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.6 4.1 1.6 5.9L.2 24l6.5-1.7c1.7.9 3.5 1.3 5.4 1.3h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.3-6.1-3.5-8.3Zm-8.3 18.1h-.1c-1.7 0-3.4-.5-4.8-1.3l-.3-.2-3.9 1 1-3.8-.2-.3a9.7 9.7 0 0 1-1.5-5.2C2.4 6.4 6.7 2 12.1 2c2.6 0 5 1 6.9 2.9a9.7 9.7 0 0 1 2.8 6.9c0 5.4-4.3 9.8-9.6 9.8Zm5.4-7.3c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2c-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-1.6-.8-2.7-1.4-3.8-3.2-.3-.5.3-.5.9-1.7.1-.2.1-.4 0-.6l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.1 1.4 3.3c.2.2 2.3 3.5 5.5 4.8 2 .8 2.8.9 3.8.8.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4 0-.2-.3-.3-.6-.5Z" />
				</svg>
				<span>تواصل معي عبر واتساب</span>
			</a>
		</div>

		<p class="hero-closing">{profile.closingLine}</p>
	</div>
	</div>
</section>

<script>
	const intro = document.querySelector("[data-intro]");

	if (intro instanceof HTMLElement) {
		const remaining = intro.querySelector(".hero-intro__remaining");
		const moreButton = intro.querySelector("[data-intro-more]");
		const lessButton = intro.querySelector("[data-intro-less]");

		if (
			remaining instanceof HTMLElement &&
			moreButton instanceof HTMLButtonElement &&
			lessButton instanceof HTMLButtonElement
		) {
			const setExpanded = (expanded: boolean) => {
				remaining.hidden = !expanded;
				moreButton.hidden = expanded;
				lessButton.hidden = !expanded;
				moreButton.setAttribute("aria-expanded", String(expanded));
				lessButton.setAttribute("aria-expanded", String(!expanded));
			};

			moreButton.addEventListener("click", () => setExpanded(true));
			lessButton.addEventListener("click", () => setExpanded(false));
		}
	}
</script>

<style>
	.hero-band {
	background: var(--color-sand-deep);
}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		align-items: center;
		gap: clamp(2.5rem, 5vw, 6rem);
		max-width: 88rem;
		min-height: 0;
		margin-inline: auto;
		/* padding: clamp(2rem, 4vw, 2.75rem) clamp(1.25rem, 4vw, 4rem) clamp(4rem, 7vw, 6rem); */
		padding: clamp(2rem, 4vw, 2.75rem) clamp(1.25rem, 4vw, 4rem) clamp(3rem, 6vw, 5rem);
	}

	.hero__visual {
		position: relative;
		isolation: isolate;
		width: min(100%, 35rem);
		margin-inline: auto;
		padding: 1.2rem 1.2rem 1.2rem 2.5rem;
	}

	.hero-image {
		position: relative;
		z-index: 2;
		display: block;
		width: 100%;
		aspect-ratio: 0.88;
		border-radius: 0.8rem;
		object-fit: cover;
	}

	.visual-frame {
		position: absolute;
		border: 1px solid var(--color-gold);
		pointer-events: none;
	}

	.visual-frame--outer {
		inset-block: 0;
		inset-inline-start: 1.2rem;
		inset-inline-end: 0;
		z-index: 0;
		transform: rotate(-3deg);
	}

	.visual-frame--inner {
		inset-block: 0.65rem;
		inset-inline-start: 1.45rem;
		inset-inline-end: 0;
		z-index: 1;
		border-color: var(--color-coffee);
		transform: rotate(2deg);
	}

	.visual-caption {
		position: absolute;
		inset-block-start: 0;
		inset-inline-end: 0;
		z-index: 3;
		color: var(--color-coffee);
		font-family: var(--font-heading);
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		writing-mode: vertical-rl;
	}

	.visual-index {
		position: absolute;
		inset-block-end: 0.2rem;
		inset-inline-start: 0;
		z-index: 3;
		color: var(--color-gold);
		font-family: var(--font-heading);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
	}

	.hero__copy {
		grid-column: 1;
		grid-row: 1;
		max-width: 42rem;
	}

	.hero__visual {
		grid-column: 2;
		grid-row: 1;
	}

	.hero-eyebrow {
		margin: 0 0 1.5rem;
		color: var(--color-coffee);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.05em;
	}

	.hero-name {
		margin: 0 0 0.4rem;
		color: var(--color-espresso);
		font-family: var(--font-heading);
		font-size: clamp(1rem, 2vw, 1.25rem);
		font-weight: 600;
	}

	/* .hero-title {
		max-width: 12ch;
		margin: 0;
		color: var(--color-espresso);
		font-family: var(--font-heading);
		font-size: clamp(3.25rem, 7vw, 6.5rem);
		font-weight: 700;
		
		letter-spacing: 0;
		line-height: 1.03;
	} */
	.hero-title {
	max-width: none;
	margin: 0;
	color: var(--color-espresso);
	font-family: var(--font-heading);
	font-size: clamp(2.4rem, 4vw, 4.25rem);
	font-weight: 700;
	letter-spacing: 0;
	line-height: 1.4;
	text-wrap: balance;
}

	/* .hero-title > span {
		display: block;
	} */
	 .hero-title__line {
	display: block;
}

	/* .hero-title em,
	.hero-title strong {
		display: inline;
	} */
	 .hero-title em,
.hero-title strong {
	font-family: var(--font-quote);
	font-size: 1.08em;
	font-style: normal;
	font-weight: 400;
	letter-spacing: 0;
}

	/* .hero-title em {
		color: var(--color-coffee);
		font-family: var(--font-quote);
		font-size: 0.9em;
		font-style: normal;
		font-weight: 400;
		letter-spacing: 0;
	} */
	 .hero-title em {
	color: var(--color-coffee);
}


	/* .hero-title strong {
		color: var(--color-sage);
		font-family: var(--font-quote);
		font-size: 1.18em;
		font-weight: 400;
		letter-spacing: 0;
	} */
	 .hero-title strong {
	position: relative;
	display: inline-block;
	margin-inline-start: 0.08em;
	color: var(--color-sage);
}
	/* updated */
	.hero-title strong {
	position: relative;
}

.hero-underline {
	position: absolute;
	inset-inline: 0;
	bottom: -0.02em;
	width: 100%;
	height: 0.26em;
	color: var(--color-gold);
	overflow: visible;
}

.hero-underline path {
	fill: none;
	stroke: currentColor;
	stroke-width: 3;
	stroke-linecap: round;
	stroke-dasharray: 1;
	stroke-dashoffset: 1;
	animation: draw-line 1.1s 0.9s ease forwards;
}

@keyframes draw-line {
	to { stroke-dashoffset: 0; }
}
/* end updated */
	.hero-intro {
		max-width: 35rem;
		margin: 2.25rem 0 0;
		color: var(--color-ink);
		font-size: clamp(0.95rem, 1.4vw, 1.1rem);
		line-height: 2;
	}

	.hero-intro__remaining[hidden],
	.intro-toggle[hidden] {
		display: none;
	}

	.intro-toggle {
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-coffee);
		cursor: pointer;
		font: inherit;
		font-weight: 700;
		text-decoration: underline;
		text-decoration-color: var(--color-gold);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
	}

	.intro-toggle:hover {
		color: var(--color-espresso);
	}

	.hero__actions {
		max-width: 22rem;
		margin-block-start: 2rem;
	}

	.hero-cta-line {
		margin: 0 0 0.65rem;
		color: var(--color-coffee);
		font-size: 0.88rem;
		font-weight: 700;
	}

	.hero-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		min-height: 3.4rem;
		padding: 0.85rem 1.25rem;
		border: 1px solid var(--color-espresso);
		border-radius: 0.6rem;
		background: var(--color-espresso);
		color: var(--color-cream);
		font-weight: 700;
		text-decoration: none;
		transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
	}

	.hero-cta svg {
		width: 1.25rem;
		height: 1.25rem;
		flex: none;
	}

	.hero-cta:hover {
		background: var(--color-coffee);
		border-color: var(--color-coffee);
	}

	.hero-cta:active {
		transform: translateY(1px);
	}

	.hero-closing {
		margin: 2.5rem 0 0;
		color: var(--color-coffee);
		font-family: var(--font-quote);
		font-size: 1.35rem;
	}

	@media (min-width: 64rem) {
		.hero__visual {
			animation: reveal-visual 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
		}

		.hero__copy > * {
			animation: reveal-copy 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
		}

		.hero__copy > :nth-child(1) { animation-delay: 80ms; }
		.hero__copy > :nth-child(2) { animation-delay: 140ms; }
		.hero__copy > :nth-child(3) { animation-delay: 200ms; }
		.hero__copy > :nth-child(4) { animation-delay: 280ms; }
		.hero__copy > :nth-child(5) { animation-delay: 360ms; }
		.hero__copy > :nth-child(6) { animation-delay: 430ms; }
		.hero-title__line {
		white-space: nowrap;
	}
	}

	@media (max-width: 63.999rem) {
		.hero {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			min-height: 0;
			padding-block: 2.5rem 5rem;
		}

		.hero__visual {
			order: 1;
			width: min(100%, 25rem);
			padding: 0.85rem 0.85rem 0.85rem 1.4rem;
		}

		.hero-image {
			aspect-ratio: 0.9;
		}

		.visual-caption {
			font-size: 0.52rem;
		}

		.hero__copy {
			order: 2;
			max-width: none;
			margin-block-start: 3.25rem;
			text-align: center;
		}

		.hero-eyebrow {
			margin-block-end: 1.25rem;
			font-size: 0.75rem;
		}

		.hero-name {
			margin-block-end: 0.25rem;
			font-size: 1.35rem;
		}

		/* .hero-title {
			max-width: none;
			font-size: clamp(2.65rem, 12vw, 4.5rem);
			line-height: 1.07;
		} */
		 .hero-title {
	max-width: none;
	font-size: clamp(2rem, 8.5vw, 3.25rem);
	line-height: 1.4;
}

		.hero-intro {
			max-width: 36rem;
			margin-inline: auto;
			margin-block-start: 1.8rem;
			font-size: 0.98rem;
			text-align: start;
		}

		.hero__actions {
			max-width: 24rem;
			margin-inline: auto;
			margin-block-start: 1.75rem;
		}

		.hero-cta-line {
			text-align: center;
		}

		.hero-cta {
			width: 100%;
		}

		.hero-closing {
			margin-block-start: 1.75rem;
			font-size: 1.25rem;
		}
	}

	@keyframes reveal-copy {
		from { opacity: 0; transform: translateY(1rem); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes reveal-visual {
		from { opacity: 0; transform: translateX(-1.25rem); }
		to { opacity: 1; transform: translateX(0); }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__visual,
		.hero__copy > * {
			animation: none;
		}

		.hero-cta {
			transition: none;
		}
		.hero-underline path {
	animation: none;
	stroke-dashoffset: 0;
}
	}
</style>
