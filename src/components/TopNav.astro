---
---

<nav class="top-nav" aria-label="التنقل الرئيسي">
	<div class="top-nav__grid">
		<a class="brand-mark" href="#home" aria-label="ابن خليل، الرئيسية">
			<span class="brand-mark__symbol" aria-hidden="true">خ</span>
			<span class="brand-mark__name">ابن خليل</span>
		</a>

		<div class="top-nav__links">
			<a href="#home">الرئيسية</a>
			<a href="#portfolio"> أعمالي</a>
		</div>

		<a class="top-nav__contact" href="#contact">تواصل</a>
	</div>
</nav>

<style>
	.top-nav {
		position: sticky;
		inset-block-start: 0;
		z-index: 40;
		background: color-mix(in srgb, var(--color-cream) 88%, transparent);
		border-block-end: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.top-nav__grid {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		grid-template-areas: "brand links contact";
		align-items: center;
		min-height: 4.75rem;
		max-width: 88rem;
		margin-inline: auto;
		padding-inline: clamp(1.25rem, 4vw, 4rem);
	}

	.brand-mark {
		grid-area: brand;
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--color-espresso);
		text-decoration: none;
	}

	.brand-mark__symbol {
		display: grid;
		width: 2.15rem;
		height: 2.15rem;
		place-items: center;
		border: 1px solid var(--color-gold);
		border-radius: 0.45rem;
		font-family: var(--font-quote);
		font-size: 1.35rem;
		line-height: 1;
	}

	.brand-mark__name {
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.03em;
	}

	.top-nav__links {
		grid-area: links;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(1.25rem, 3vw, 2.75rem);
	}

	.top-nav__links a,
	.top-nav__contact {
		position: relative;
		color: var(--color-ink);
		font-size: 0.88rem;
		font-weight: 500;
		text-decoration: none;
	}

	.top-nav__links a::after {
		position: absolute;
		inset-block-end: -0.4rem;
		inset-inline: 50%;
		width: 0;
		height: 1px;
		background: var(--color-gold);
		content: "";
		transition: width 180ms ease, inset-inline 180ms ease;
	}

	.top-nav__links a:hover,
	.top-nav__contact:hover {
		color: var(--color-coffee);
	}

	.top-nav__links a:hover::after {
		inset-inline: 0;
		width: auto;
	}

	.top-nav__contact {
		grid-area: contact;
		justify-self: end;
		padding: 0.55rem 1rem;
		border: 1px solid var(--color-coffee);
		border-radius: 0.45rem;
		color: var(--color-coffee);
		transition: background-color 180ms ease, color 180ms ease;
	}

	.top-nav__contact:hover {
		background: var(--color-espresso);
		border-color: var(--color-espresso);
		color: var(--color-cream);
	}

	@media (max-width: 40rem) {
		.top-nav__grid {
			min-height: 4.25rem;
			padding-inline: 1rem;
		}

		.brand-mark {
			gap: 0.5rem;
		}

		.brand-mark__symbol {
			width: 1.9rem;
			height: 1.9rem;
			font-size: 1.15rem;
		}

		.brand-mark__name {
			font-size: 0.82rem;
		}

		.top-nav__links {
			gap: 0.7rem;
		}

		.top-nav__links a,
		.top-nav__contact {
			font-size: 0.73rem;
		}

		.top-nav__contact {
			padding: 0.42rem 0.65rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.top-nav__links a::after,
		.top-nav__contact {
			transition: none;
		}
	}
</style>
